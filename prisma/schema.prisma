generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubTier {
  PAYG
  MONTHLY
  PLUS
}

enum FreshBoxSize {
  SMALL
  MEDIUM
  LARGE
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  passwordHash  String
  isAdmin       Boolean        @default(false)
  createdAt     DateTime       @default(now())

  // Subscription / billing
  stripeCustomerId String? @unique

  // Referral programme
  referralCode     String?  @unique
  referredById     String?
  referredBy       User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals        User[]   @relation("Referrals")
  referralRewarded Boolean  @default(false)
  creditCents      Int      @default(0)

  // Sign-ins that started before this are ended (see the jwt callback in lib/auth.ts),
  // except the one that made the change in Settings.
  passwordChangedAt        DateTime?
  passwordChangedBySession String?

  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orders        Order[]
  subscription  Subscription?
  freshBox      FreshBoxSubscription?
  passwordResetTokens PasswordResetToken[]

  @@index([referredById]) // referral counts on the profile
}

model FreshBoxSubscription {
  id                   String       @id @default(cuid())
  userId               String       @unique
  size                 FreshBoxSize @default(MEDIUM)
  // 1 = Monday, 2 = Tuesday, 3 = Wednesday (orders processed Mon–Wed only)
  deliveryWeekday      Int          @default(2)
  status               String       @default("active") // active | past_due | canceled
  stripeSubscriptionId String?      @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  tier                 SubTier   @default(PAYG)
  status               String    @default("active") // active | past_due | canceled
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String
  // price stored in minor units (pence) to avoid float rounding issues
  priceCents     Int
  currency       String   @default("gbp")
  imageUrl       String
  category       String
  brand          String? // brand / source, e.g. "AfroPantry Private Label"
  isPrivateLabel Boolean  @default(false)
  size           String? // pack size shown under the name, e.g. "1kg", "5-pack"
  badges         String[] @default([]) // short highlights, e.g. "Co-op sourced"
  stock          Int      @default(100)
  archivedAt     DateTime? // hidden from the shop but kept for past orders
  createdAt      DateTime @default(now())

  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  orderItems        OrderItem[]
  recipeIngredients RecipeIngredient[]

  @@index([category]) // category filter on the home page
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

enum OrderStatus {
  PENDING // checkout started, not paid yet
  AWAITING_PAYMENT // checkout finished with a delayed method (e.g. bank debit); money not in yet
  PAID
  CANCELLED // checkout expired, payment failed, or abandoned
}

/// Where a paid order is in packing and delivery (payment lives in OrderStatus).
enum FulfilmentStatus {
  UNFULFILLED
  PACKED
  SHIPPED
  DELIVERED
}

model Order {
  id                 String      @id @default(cuid())
  userId             String
  status             OrderStatus @default(PENDING)
  // subtotal of items before discounts/delivery
  subtotalCents      Int         @default(0)
  discountCents      Int         @default(0)
  deliveryCents      Int         @default(0)
  creditAppliedCents Int         @default(0)
  totalCents         Int
  currency           String      @default("gbp")
  stripeSessionId    String?     @unique
  // delivery details collected by Stripe Checkout, saved when the order is paid
  shippingName       String?
  shippingPhone      String?
  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingPostcode   String?
  shippingCountry    String?
  paidAt             DateTime?
  // packing and delivery, updated by admins
  fulfilment         FulfilmentStatus @default(UNFULFILLED)
  packedAt           DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  carrier            String?
  trackingNumber     String?
  createdAt          DateTime    @default(now())
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items              OrderItem[]
  emails             EmailLog[]

  @@index([userId, createdAt]) // order history, newest first
  @@index([status, fulfilment, createdAt]) // admin order lists
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  // snapshot of price at purchase time
  unitPriceCents Int
  nameSnapshot   String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Recipe {
  id          String             @id @default(cuid())
  slug        String             @unique
  title       String
  description String
  imageUrl    String
  steps       String[]
  servings    Int                @default(4)
  minutes     Int                @default(45)
  difficulty  String             @default("Medium") // Easy | Medium | Hard
  isPremium   Boolean            @default(false) // Plus-only recipe
  createdAt   DateTime           @default(now())
  ingredients RecipeIngredient[]
}

model RecipeIngredient {
  id        String   @id @default(cuid())
  recipeId  String
  productId String? // tappable link to a stocked product (null for pantry basics)
  label     String // ingredient name, e.g. "Long grain rice"
  amount    String? // quantity, e.g. "2 cups" (null for "to taste" items)
  sortOrder Int      @default(0)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([recipeId])
  @@index([productId]) // "Use in these recipes" on product pages
}

/// Fixed-window attempt counters (sign-in, sign-up, password change, checkout),
/// kept in Postgres so limits hold across every server instance.
model RateLimit {
  key     String   @id // e.g. "signin:email:ada@example.com"
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt]) // clearing out expired windows
}

/// One-time password reset links. Only a SHA-256 hash of the emailed token is
/// stored, so the database alone can't be used to reset anyone's password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Every email the shop tried to send, and what happened. Never stores the body.
model EmailLog {
  id         String   @id @default(cuid())
  to         String
  kind       String // order_confirmation | order_shipped | password_reset
  subject    String
  status     String // sent | failed | skipped
  providerId String? // Resend's email id
  error      String?
  orderId    String?
  createdAt  DateTime @default(now())
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
}
